/- Guide for E019 (Add instance).
Part R: one reference entry per tactic, term or lemma the exercise needs, stated with typed
placeholders. Put the cursor before and after the step to see the proof state change in the infoview.
`P` stands for "the rest of your goal": the step changes only the part shown inside `P (…)`. A
hypothesis `h` in an entry is only there to finish the example; it shows what the goal became.
The entries use `Mul` (the class behind `*`) on the structure `Pair` below, NOT `Add` on the
exercise's `V2`: `Add` and `+` work exactly the same way.
Part W: worked combinations on `Pair`.
Assumed: Lean basics up to E018, in particular `rfl` (E001), `exact`/`apply` (E003), `⟨_, _⟩`
(E004), `constructor` (E005), structures, projections and `dsimp only` (E017).
-/

namespace E019Guide

/-- Two natural numbers. `@[ext]` asks Lean to generate the extensionality lemma
`Pair.ext : x.a = y.a → x.b = y.b → x = y` (R6). -/
@[ext] structure Pair where
  a : Nat
  b : Nat

/-! # Part R · Reference entries -/

/-! ## Building an instance -/

/-! ### R1. `constructor` on `⊢ Mul α` · goal → one goal per field of the class
`Mul α` is a class: a structure with one field `mul : α → α → α`. `constructor` applies its
constructor `Mul.mk` and leaves that field's type as the goal: a function that takes two `α`s. -/
example {α : Type} (f : α → α → α) : Mul α := by
  constructor
  exact f

/-! ### R2. `⟨f⟩` (anonymous constructor) · closes `⊢ Mul α`
`⟨f⟩` is `Mul.mk f`; `{ mul := f }` is the same term with the field named. In an `instance … :=`
body you write this term directly, with `f` a `fun p q => …` that builds the result. -/
example {α : Type} (f : α → α → α) : Mul α := by
  exact ⟨f⟩

/-- An `instance` declaration registers the value, so `p * q` now elaborates for `p q : Pair`.
The product is computed field by field. -/
instance instMulPair : Mul Pair := ⟨fun p q => ⟨p.a * q.a, p.b * q.b⟩⟩

/-! ## What `p * q` means -/

/-! ### R3. `dsimp only [HMul.hMul]` · goal: the notation `p * q` → `Mul.mul p q`
`p * q` is notation for `HMul.hMul p q`; Lean builds `HMul Pair Pair Pair` from your `Mul Pair`
instance, so unfolding `HMul.hMul` leaves the class function `Mul.mul`. -/
example (p q : Pair) (P : Pair → Prop) (h : P (Mul.mul p q)) : P (p * q) := by
  dsimp only [HMul.hMul]
  exact h

/-! ### R4. `dsimp only [Mul.mul]` · goal: `Mul.mul p q` → the instance body, projections reduced -/
example (p q : Pair) (P : Nat → Prop) (h : P (p.a * q.a)) : P (Mul.mul p q).a := by
  dsimp only [Mul.mul]
  exact h

/-! ### R5. `rfl` through an instance · closes a field equation that holds by the instance body
`rfl` does R3 and R4 by itself: it unfolds `*` to the instance body and reduces the projection. -/
example (p q : Pair) : (p * q).a = p.a * q.a := by
  rfl

/-! ## Equality of structures -/

/-! ### R6. `apply Pair.ext` (generated by `@[ext]`) · goal `x = y` → one goal per field
`Pair.ext : x.a = y.a → x.b = y.b → x = y`, with `x y` implicit. `apply` leaves the two premises,
labelled by field (`case a`, `case b`). The tactic `ext` does the same. -/
example (x y : Pair) (ha : x.a = y.a) (hb : x.b = y.b) : x = y := by
  apply Pair.ext
  exact ha
  exact hb

/-! ## The library lemma -/

/-! ### R7. `Int.add_comm` · `Int.add_comm (a b : Int) : a + b = b + a` · closes the goal
Both arguments are explicit. It is about `Int`; `Nat.add_comm` is the `Nat` version. -/
example (a b : Int) : a + b = b + a := by
  exact Int.add_comm a b

/-! # Part W · Worked combinations (on `Pair` and `*`, not the exercise's `V2` and `+`) -/

/-! ### W1. `exact` accepts a proof whose type agrees with the goal after unfolding
After R6 the goal is `(p * q).a = (q * p).a`, not literally `p.a * q.a = q.a * p.a`. Both unfold
(R3, R4) to the same statement, so `exact Nat.mul_comm p.a q.a` closes it as it stands. -/
example (p q : Pair) : p * q = q * p := by
  apply Pair.ext
  exact Nat.mul_comm p.a q.a
  exact Nat.mul_comm p.b q.b

/-! ### W2. The same with the `ext` tactic and `·` to focus each goal -/
example (p q : Pair) : p * q = q * p := by
  ext
  · exact Nat.mul_comm p.a q.a
  · exact Nat.mul_comm p.b q.b

end E019Guide
