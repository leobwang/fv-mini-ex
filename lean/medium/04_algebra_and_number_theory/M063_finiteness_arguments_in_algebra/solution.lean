/- M063 | Finiteness arguments in algebra | 15-20 min | Finite, injective iff surjective, Nat.card, IsCyclic, zpowers, mathlib
GOAL
  (1) In a finite integral domain every nonzero `a` has an inverse: `x ↦ a * x` is injective, hence
  surjective. (2) A group of prime order `p` is cyclic (generated by one element). Mathlib's
  Lagrange theorem is allowed. `Nat.card G` is the number of elements of `G`.
BANNED: Finite.isDomain_to_isField, Finite.isField_of_domain, IsArtinianRing.isField_of_isDomain, IsField, Fintype.fieldOfDomain, Fintype.divisionRingOfIsDomain, Fintype.groupWithZeroOfCancel, isCyclic_of_prime_card, isCyclic_of_card_dvd_prime, zpowers_eq_top_of_prime_card, powers_eq_top_of_prime_card, mem_zpowers_of_prime_card, mem_powers_of_prime_card, isCyclic_of_orderOf_eq_card, Subgroup.eq_bot_or_eq_top_of_prime_card, isSimpleGroup_of_prime_card, IsSimpleGroup, mul_right_bijective_of_finite₀, mul_left_bijective_of_finite₀, isUnit_iff_mem_nonZeroDivisors_of_finite, isRegular_iff_isUnit_of_finite, IsLeftRegular.isUnit_of_finite, IsArtinianRing, IsZGroup, IsPGroup.isCyclic_of_isZGroup, exact?, apply?, rw?, hint, try?

GUIDE
  Entries R1–R19: one per tactic or lemma, with the proof state before and after.
    cheatsheet.md   read
    guide.lean      step through in the infoview
  Each theorem below has a SKELETON: the order in which those entries are used.
-/
import Mathlib

namespace M063

/- SKELETON · domain_inv
  1. The map `x ↦ a * x` is injective: state it with its type and prove it by cancellation
       hinj : Function.Injective (fun x : R => a * x)        proof: R1 (`fun x y hxy => …`) → R2
  2. Injective self-map of a finite type → surjective:       R3 (`.mp hinj`)
  3. Surjectivity at the point `1` gives `b` and `hb`:        R4
  4. `b` is the witness; `hb` fits as it stands:              R5
-/
-- BEGIN SPEC
theorem domain_inv {R : Type*} [CommRing R] [IsDomain R] [Finite R] (a : R) (ha : a ≠ 0) :
    ∃ b, a * b = 1 :=
-- END SPEC
  by
    have hinj : Function.Injective (fun x : R => a * x) := fun x y hxy => mul_left_cancel₀ ha hxy
    obtain ⟨b, hb⟩ := Finite.injective_iff_surjective.mp hinj 1
    exact ⟨b, hb⟩

/- SKELETON · prime_order_cyclic
  1. `G` has two distinct elements: 1 < p = Nat.card G
       haveI : Nontrivial G                                  proof: R8 (`.mp`) of R7 (`h ▸ …`) of R6
  2. Pick an element other than 1:  g, hg : g ≠ 1            R9
  3. Lagrange for the subgroup `zpowers g` (R10), moved to `p`:
       hd : Nat.card (Subgroup.zpowers g) ∣ p                proof: R7 (`h ▸ …`) of R11
  4. `p` is prime, so that card is 1 or p; split the cases:  R12 → R13
  5. Case card = 1: then `zpowers g = ⊥`, then `g = 1`, which contradicts `hg`:
                                                             R14 (`.mp`) → R15 (`.mp`) → R16
  6. Case card = p: `G` is cyclic with generator `g`, because `zpowers g` has all `Nat.card G` elements:
                                                             R17 (`.mpr ⟨g, …⟩`) → R18 → R19 (with `h`)
-/
-- BEGIN SPEC
theorem prime_order_cyclic {G : Type*} [Group G] [Finite G] {p : ℕ} (hp : p.Prime)
    (h : Nat.card G = p) : IsCyclic G :=
-- END SPEC
  by
    haveI : Nontrivial G := Finite.one_lt_card_iff_nontrivial.mp (h ▸ hp.one_lt)
    obtain ⟨g, hg⟩ := exists_ne (1 : G)
    have hd : Nat.card (Subgroup.zpowers g) ∣ p := h ▸ Subgroup.card_subgroup_dvd_card _
    rcases hp.eq_one_or_self_of_dvd _ hd with h1 | h1
    · exact absurd (Subgroup.zpowers_eq_bot.mp (Subgroup.card_eq_one.mp h1)) hg
    · exact isCyclic_iff_exists_zpowers_eq_top.mpr
        ⟨g, Subgroup.eq_top_of_card_eq _ (h1.trans h.symm)⟩

end M063

/- ─────────────────────────── HINTS (spoilers below) ───────────────────────────
H1. (1) Look at the map `x ↦ a * x` on `R`: it is injective (cancel `a ≠ 0`), and on a finite type that
    makes it surjective, so something maps to `1`.
    (2) A group with `p ≥ 2` elements has some `g ≠ 1`. Look at the subgroup `zpowers g` it generates.
H2. (1) R1 + R2 for injectivity, R3 to get surjectivity, R4 at the point `1`, R5 to finish.
    (2) Lagrange (R11) says `Nat.card (zpowers g)` divides `p`, so it is `1` or `p` (R12, R13).
    If `1`: `zpowers g = ⊥` (R14), so `g = 1` (R15), contradicting `hg` (R16).
    If `p`: `zpowers g = ⊤` (R18, R19), and `G` is cyclic (R17).
H3. (1) `have hinj : Function.Injective (fun x : R => a * x) := fun x y hxy => mul_left_cancel₀ ha hxy`,
    then `obtain ⟨b, hb⟩ := Finite.injective_iff_surjective.mp hinj 1`.
    (2) `haveI : Nontrivial G := Finite.one_lt_card_iff_nontrivial.mp (h ▸ hp.one_lt)`,
    `have hd : Nat.card (Subgroup.zpowers g) ∣ p := h ▸ Subgroup.card_subgroup_dvd_card _`, then
    `rcases hp.eq_one_or_self_of_dvd _ hd with h1 | h1` and in the second case
    `isCyclic_iff_exists_zpowers_eq_top.mpr ⟨g, Subgroup.eq_top_of_card_eq _ (h1.trans h.symm)⟩`.
-/
