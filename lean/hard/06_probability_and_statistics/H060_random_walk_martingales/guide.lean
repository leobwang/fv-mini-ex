/- Guide for H060 (Random-walk martingales).
Part R: one reference entry per tactic or library lemma the exercise needs, stated with typed
placeholders. Put the cursor before and after the step to see the proof state change in the infoview.
`P` stands for "the rest of your goal": the step changes only the part shown inside `P (…)`. A
hypothesis `h` or `k` in an entry is only there to finish the example; it shows what the goal became.
`Ω` is a sample space with its ambient σ-algebra `mΩ`; `m`, `m'`, `m₁`, `m₂` are other σ-algebras on `Ω`.
Part W: worked combinations on objects that are NOT the exercise's.
Assumed: Lean basics (E001–E033).
-/
import Mathlib

namespace H060Guide

open MeasureTheory ProbabilityTheory

/-! # Part R · Reference entries -/

/-! ## Measurability of a partial sum -/

/-! ### R1. `apply Finset.stronglyMeasurable_fun_sum` · goal: a sum is measurable → each summand is -/
example {Ω ι : Type} {m : MeasurableSpace Ω} (s : Finset ι) (f : ι → Ω → ℝ)
    (h : ∀ i ∈ s, StronglyMeasurable[m] (f i)) :
    StronglyMeasurable[m] (fun ω => ∑ i ∈ s, f i ω) := by
  apply Finset.stronglyMeasurable_fun_sum
  exact h

/-! ### R2. `Finset.mem_range_succ_iff` · `i ∈ Finset.range (n + 1) ↔ i ≤ n` · context -/
example (i n : ℕ) (hi : i ∈ Finset.range (n + 1)) (G : Prop) (k : i ≤ n → G) : G := by
  have h := Finset.mem_range_succ_iff.mp hi
  exact k h

/-! ### R3. `Filtration.stronglyAdapted_natural hY i` · context gains: `Y i` is `ℱ i`-measurable
`Filtration.natural Y hY i` is `ℱ i = σ(Y 0, …, Y i)`. The infoview hides the `[ℱ i]`. -/
example {Ω : Type} [MeasurableSpace Ω] (Y : ℕ → Ω → ℝ) (hY : ∀ i, StronglyMeasurable (Y i)) (i : ℕ)
    (G : Prop) (k : StronglyMeasurable[Filtration.natural Y hY i] (Y i) → G) : G := by
  have h := Filtration.stronglyAdapted_natural hY i
  exact k h

/-! ### R4. `Filtration.mono` · `i ≤ j → ℱ i ≤ ℱ j` (information only grows) · context -/
example {Ω : Type} [MeasurableSpace Ω] (Y : ℕ → Ω → ℝ) (hY : ∀ i, StronglyMeasurable (Y i))
    (i j : ℕ) (hij : i ≤ j) (G : Prop)
    (k : Filtration.natural Y hY i ≤ Filtration.natural Y hY j → G) : G := by
  have h := (Filtration.natural Y hY).mono hij
  exact k h

/-! ### R5. `StronglyMeasurable.mono` · `StronglyMeasurable[m'] f → m' ≤ m → StronglyMeasurable[m] f`
`refine hf.mono ?_` · goal: measurability for the bigger `m` → `m' ≤ m` -/
example {Ω : Type} {m m' : MeasurableSpace Ω} (f : Ω → ℝ) (hf : StronglyMeasurable[m'] f)
    (hle : m' ≤ m) : StronglyMeasurable[m] f := by
  refine hf.mono ?_
  exact hle

/-! ## Conditional expectation of an independent variable -/

/-! ### R6. `condExp_indep_eq` · `f` independent of `m₂` → `μ[f | m₂] =ᵐ[μ] fun _ => μ[f]` · context -/
example {Ω : Type} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {m₁ m₂ : MeasurableSpace Ω} (hle₁ : m₁ ≤ mΩ) (hle₂ : m₂ ≤ mΩ) (f : Ω → ℝ)
    (hf : StronglyMeasurable[m₁] f) (hind : Indep m₁ m₂ μ) (G : Prop)
    (k : (μ[f | m₂] =ᵐ[μ] fun _ => μ[f]) → G) : G := by
  have h := condExp_indep_eq hle₁ hle₂ hf hind
  exact k h

/-! ### R7. `StronglyMeasurable.measurable` · strongly measurable → measurable · context -/
example {Ω : Type} [MeasurableSpace Ω] (f : Ω → ℝ) (hf : StronglyMeasurable f) (G : Prop)
    (k : Measurable f → G) : G := by
  have h := hf.measurable
  exact k h

/-! ### R8. `Measurable.comap_le` · `Measurable f → σ(f) ≤ mΩ` · context
`MeasurableSpace.comap f inferInstance` is `σ(f)`, the σ-algebra generated by `f`. -/
example {Ω : Type} [mΩ : MeasurableSpace Ω] (f : Ω → ℝ) (hf : Measurable f) (G : Prop)
    (k : MeasurableSpace.comap f inferInstance ≤ mΩ → G) : G := by
  have h := hf.comap_le
  exact k h

/-! ### R9. `Filtration.le` · `ℱ i ≤ mΩ` (every `ℱ i` is a sub-σ-algebra) · context -/
example {Ω : Type} [mΩ : MeasurableSpace Ω] (𝓕 : Filtration ℕ mΩ) (i : ℕ) (G : Prop)
    (k : 𝓕 i ≤ mΩ → G) : G := by
  have h := 𝓕.le i
  exact k h

/-! ### R10. `comap_measurable` · `f` is `σ(f)`-measurable · context -/
example {Ω : Type} (f : Ω → ℝ) (G : Prop)
    (k : Measurable[MeasurableSpace.comap f inferInstance] f → G) : G := by
  have h : Measurable[MeasurableSpace.comap f inferInstance] f := comap_measurable f
  exact k h

/-! ### R11. `Measurable.stronglyMeasurable` · for `ℝ`-valued `f`: measurable → strongly measurable · context -/
example {Ω : Type} {m : MeasurableSpace Ω} (f : Ω → ℝ) (hf : Measurable[m] f) (G : Prop)
    (k : StronglyMeasurable[m] f → G) : G := by
  have h := hf.stronglyMeasurable
  exact k h

/-! ### R12. `iIndepFun.indep_comap_natural_of_lt` · `i < j` → `σ(Y j)` independent of `ℱ i` · context
`Nat.lt_succ_self i : i < i.succ` (`i.succ` is `i + 1`) supplies the `i < j`. -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (Y : ℕ → Ω → ℝ)
    (hY : ∀ i, StronglyMeasurable (Y i)) (hind : iIndepFun Y μ) (i : ℕ) (G : Prop)
    (k : Indep (MeasurableSpace.comap (Y (i + 1)) inferInstance) (Filtration.natural Y hY i) μ → G) :
    G := by
  have h := hind.indep_comap_natural_of_lt hY (Nat.lt_succ_self i)
  exact k h

/-! ### R13. `rw [hm] at h` · context: rewrite inside a hypothesis instead of the goal -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (f g : Ω → ℝ) (hm : μ[f] = 0)
    (h : g =ᵐ[μ] fun _ => μ[f]) (G : Prop) (k : (g =ᵐ[μ] fun _ => 0) → G) : G := by
  rw [hm] at h
  exact k h

/-! ## Algebra of the increment -/

/-! ### R14. `rw [Finset.sum_range_succ _ (n + 1)]` · goal: peel the last term off the longer sum
`Finset.sum_range_succ f n : ∑ x ∈ range (n + 1), f x = ∑ x ∈ range n, f x + f n`. Giving `n + 1`
rewrites only `range (n + 1 + 1)` and leaves `range (n + 1)` alone. -/
example (f : ℕ → ℝ) (n : ℕ) (P : ℝ → ℝ → Prop)
    (h : P (∑ i ∈ Finset.range (n + 1), f i + f (n + 1)) (∑ i ∈ Finset.range (n + 1), f i)) :
    P (∑ i ∈ Finset.range (n + 1 + 1), f i) (∑ i ∈ Finset.range (n + 1), f i) := by
  rw [Finset.sum_range_succ _ (n + 1)]
  exact h

/-! ### R15. `push_cast` · goal: casts `ℕ → ℝ` pushed inward, `↑(n + 1)` → `↑n + 1` -/
example (n : ℕ) (P : ℝ → Prop) (h : P ((n : ℝ) + 1)) : P ((n + 1 : ℕ) : ℝ) := by
  push_cast
  exact h

/-! ### R16. `linear_combination h` · closes `a = b` when `a - b = c * (lhs h - rhs h)` is a ring identity
Here `(s + x)² - 1 - (s² + 2sx) = x² - 1`, i.e. `1 · (lhs h - rhs h)`. -/
example (s x : ℝ) (h : x ^ 2 = 1) : (s + x) ^ 2 - 1 = s ^ 2 + 2 * s * x := by
  linear_combination h

/-! ## The martingale criterion -/

/-! ### R17. `apply martingale_of_condExp_sub_eq_zero_nat` · goal → three goals: adapted, integrable,
increments have conditional expectation `0` -/
example {Ω : Type} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    (𝓕 : Filtration ℕ mΩ) (f : ℕ → Ω → ℝ) (h1 : StronglyAdapted 𝓕 f) (h2 : ∀ i, Integrable (f i) μ)
    (h3 : ∀ i, μ[f (i + 1) - f i | 𝓕 i] =ᵐ[μ] 0) : Martingale f 𝓕 μ := by
  apply martingale_of_condExp_sub_eq_zero_nat
  exacts [h1, h2, h3]

/-! ### R18. `intro n` on `StronglyAdapted 𝓕 f` · goal: `∀ n, f n is 𝓕 n-measurable` in disguise -/
example {Ω : Type} [mΩ : MeasurableSpace Ω] (𝓕 : Filtration ℕ mΩ) (f : ℕ → Ω → ℝ)
    (h : ∀ n, StronglyMeasurable[𝓕 n] (f n)) : StronglyAdapted 𝓕 f := by
  intro n
  exact h n

/-! ### R19. `apply integrable_finsetSum` · goal: a finite sum is integrable → each summand is -/
example {Ω ι : Type} [MeasurableSpace Ω] {μ : Measure Ω} (s : Finset ι) (f : ι → Ω → ℝ)
    (h : ∀ i ∈ s, Integrable (f i) μ) : Integrable (fun ω => ∑ i ∈ s, f i ω) μ := by
  apply integrable_finsetSum
  exact h

/-! ### R20. `Pi.sub_apply` · `(f - g) ω = f ω - g ω` (functions are subtracted pointwise) · goal
`simp` applies it by itself; it is what makes `funext ω` useful on `F - G = H`. -/
example {Ω : Type} (f g : Ω → ℝ) (ω : Ω) (P : ℝ → Prop) (h : P (f ω - g ω)) : P ((f - g) ω) := by
  rw [Pi.sub_apply]
  exact h

/-! ## Bounded, hence integrable -/

/-! ### R21. `Real.norm_eq_abs` · `‖r‖ = |r|` on `ℝ` · goal -/
example (r : ℝ) (P : ℝ → Prop) (h : P |r|) : P ‖r‖ := by
  rw [Real.norm_eq_abs]
  exact h

/-! ### R22. `Integrable.of_bound` · goal: `Integrable f μ` → an a.e. bound `‖f x‖ ≤ C`
Needs `AEStronglyMeasurable f μ` and a finite measure (a probability measure is one). -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] (f : Ω → ℝ)
    (hf : AEStronglyMeasurable f μ) (C : ℝ) (h : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) : Integrable f μ := by
  refine Integrable.of_bound hf C ?_
  exact h

/-! ### R23. `StronglyMeasurable.aestronglyMeasurable` · goal: a.e.-version → the everywhere version -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (f : Ω → ℝ) (h : StronglyMeasurable f) :
    AEStronglyMeasurable f μ := by
  apply StronglyMeasurable.aestronglyMeasurable
  exact h

/-! ### R24. `ae_of_all μ` · goal: `∀ᵐ x ∂μ, p x` → `∀ x, p x` (true everywhere ⇒ true a.e.) -/
example {Ω : Type} [MeasurableSpace Ω] (μ : Measure Ω) (p : Ω → Prop) (h : ∀ x, p x) :
    ∀ᵐ x ∂μ, p x := by
  apply ae_of_all μ
  exact h

/-! ### R25. `set S : T := e with hS` · context gains `S := e` and `hS : S = e`; goal: `e` → `S` -/
example (g : ℕ → ℝ) (P : (ℕ → ℝ) → Prop) (h : P (fun n => g n + 1)) : P (fun n => g n + 1) := by
  set T : ℕ → ℝ := fun n => g n + 1 with hT
  exact h

/-! ### R26. `Finset.abs_sum_le_sum_abs` · `|∑ i ∈ s, f i| ≤ ∑ i ∈ s, |f i|` (triangle inequality) · context -/
example {ι : Type} (s : Finset ι) (f : ι → ℝ) (G : Prop)
    (k : |∑ i ∈ s, f i| ≤ ∑ i ∈ s, |f i| → G) : G := by
  have h := Finset.abs_sum_le_sum_abs f s
  exact k h

/-! ### R27. `apply Finset.sum_le_sum` · goal: compare two sums → compare them term by term -/
example {ι : Type} (s : Finset ι) (f g : ι → ℝ) (h : ∀ i ∈ s, f i ≤ g i) :
    ∑ i ∈ s, f i ≤ ∑ i ∈ s, g i := by
  apply Finset.sum_le_sum
  exact h

/-! ### R28. `simp` on a constant sum · goal: `∑ i ∈ range k, (1 : ℝ)` → `↑k` -/
example (k : ℕ) (P : ℝ → Prop) (h : P (k : ℝ)) : P (∑ _ ∈ Finset.range k, (1 : ℝ)) := by
  simp
  exact h

/-! ### R29. `abs_pow` · `|a ^ n| = |a| ^ n` · goal -/
example (a : ℝ) (n : ℕ) (P : ℝ → Prop) (h : P (|a| ^ n)) : P |a ^ n| := by
  rw [abs_pow]
  exact h

/-! ### R30. `pow_le_pow_left₀` · `0 ≤ a → a ≤ b → a ^ n ≤ b ^ n` · goal list: two side goals
`abs_nonneg a : 0 ≤ |a|` closes the first when `a` is an absolute value. -/
example (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) : a ^ 2 ≤ b ^ 2 := by
  refine pow_le_pow_left₀ ?_ ?_ 2
  exacts [ha, hab]

/-! ## Measurability and integrability of combinations (dot notation on a hypothesis) -/

/-! ### R31. `hf.pow n`, `hf.sub hg`, `stronglyMeasurable_const` · context: measurability of `f ^ n`, `f - g`, a constant
`f ^ 2` and `f - g` on functions mean `fun ω => f ω ^ 2` and `fun ω => f ω - g ω`. -/
example {Ω : Type} {m : MeasurableSpace Ω} (f : Ω → ℝ) (c : ℝ) (hf : StronglyMeasurable[m] f)
    (G : Prop) (k : StronglyMeasurable[m] (f ^ 2 - fun _ => c) → G) : G := by
  have h := (hf.pow 2).sub (stronglyMeasurable_const (b := c))
  exact k h

/-! ### R32. `AEStronglyMeasurable.pow` · context: `hf.pow n : AEStronglyMeasurable (f ^ n) μ` -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (f : Ω → ℝ) (hf : AEStronglyMeasurable f μ)
    (G : Prop) (k : AEStronglyMeasurable (f ^ 2) μ → G) : G := by
  have h := hf.pow 2
  exact k h

/-! ### R33. `Integrable.sub`, `integrable_const` · context: `hf.sub (integrable_const c) : Integrable (f - fun _ => c) μ` -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] (f : Ω → ℝ) (c : ℝ)
    (hf : Integrable f μ) (G : Prop) (k : Integrable (f - fun _ => c) μ → G) : G := by
  have h := hf.sub (integrable_const c)
  exact k h

/-! ### R34. `Integrable.const_mul` · context: `hf.const_mul c : Integrable (fun x => c * f x) μ` -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (f : Ω → ℝ) (c : ℝ) (hf : Integrable f μ)
    (G : Prop) (k : Integrable (fun x => c * f x) μ → G) : G := by
  have h := hf.const_mul c
  exact k h

/-! ### R35. `Integrable.mul_bdd` · integrable × bounded measurable is integrable · context -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (f g : Ω → ℝ) (C : ℝ) (hf : Integrable f μ)
    (hg : AEStronglyMeasurable g μ) (hgC : ∀ᵐ x ∂μ, ‖g x‖ ≤ C) (G : Prop)
    (k : Integrable (fun x => f x * g x) μ → G) : G := by
  have h := hf.mul_bdd hg hgC
  exact k h

/-! ### R36. `StronglyMeasurable.const_mul` · context: `hf.const_mul c : StronglyMeasurable (fun x => c * f x)` -/
example {Ω : Type} {m : MeasurableSpace Ω} (f : Ω → ℝ) (c : ℝ) (hf : StronglyMeasurable[m] f)
    (G : Prop) (k : StronglyMeasurable[m] (fun x => c * f x) → G) : G := by
  have h := hf.const_mul c
  exact k h

/-! ## Pulling out what is known, and working pointwise -/

/-! ### R37. `condExp_mul_of_stronglyMeasurable_left` · pull-out: `μ[f * g | m] =ᵐ[μ] f * μ[g | m]` · context
Needs `f` `m`-measurable, `f * g` and `g` integrable. -/
example {Ω : Type} {m mΩ : MeasurableSpace Ω} {μ : Measure Ω} (f g : Ω → ℝ)
    (hf : StronglyMeasurable[m] f) (hfg : Integrable (f * g) μ) (hg : Integrable g μ) (G : Prop)
    (k : μ[f * g | m] =ᵐ[μ] f * μ[g | m] → G) : G := by
  have h := condExp_mul_of_stronglyMeasurable_left hf hfg hg
  exact k h

/-! ### R38. `refine h.trans ?_` (`Filter.EventuallyEq.trans`) · goal: `a =ᵐ c` → `b =ᵐ c`, given `h : a =ᵐ b` -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (a b c : Ω → ℝ) (h : a =ᵐ[μ] b)
    (h' : b =ᵐ[μ] c) : a =ᵐ[μ] c := by
  refine h.trans ?_
  exact h'

/-! ### R39. `filter_upwards [h] with ω hω` · goal: `F =ᵐ G` → `F ω = G ω` for a generic `ω`,
with `hω`, the pointwise form of `h`, in the context -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (u v F G : Ω → ℝ) (h : u =ᵐ[μ] v)
    (k : ∀ ω, u ω = v ω → F ω = G ω) : F =ᵐ[μ] G := by
  filter_upwards [h] with ω hω
  exact k ω hω

/-! ### R40. `Pi.mul_apply`, `Pi.zero_apply` · `(f * g) ω = f ω * g ω`, `(0 : Ω → ℝ) ω = 0` · goal
`simp [hω]` applies both by itself and then rewrites with `hω`. -/
example {Ω : Type} (f g : Ω → ℝ) (ω : Ω) (P : ℝ → ℝ → Prop) (h : P (f ω * g ω) 0) :
    P ((f * g) ω) ((0 : Ω → ℝ) ω) := by
  rw [Pi.mul_apply, Pi.zero_apply]
  exact h

/-! # Part W · Worked combinations (not the exercise's objects) -/

/-! ### W1. An increment by `funext` + `simp`: the doubled walk `Tₙ = ∑ 2·Yᵢ` (R20, R14) -/
example {Ω : Type} (Y : ℕ → Ω → ℝ) (n : ℕ) :
    ((fun ω => ∑ i ∈ Finset.range (n + 1 + 1), 2 * Y i ω) - fun ω => ∑ i ∈ Finset.range (n + 1), 2 * Y i ω)
      = fun ω => 2 * Y (n + 1) ω := by
  funext ω
  simp [Finset.sum_range_succ _ (n + 1)]

/-! ### W2. Bounded by 3, hence integrable (R22, R23, R24) -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] (f : Ω → ℝ)
    (hf : StronglyMeasurable f) (hb : ∀ ω, |f ω| ≤ 3) : Integrable f μ := by
  refine Integrable.of_bound hf.aestronglyMeasurable 3 ?_
  exact ae_of_all μ fun ω => hb ω

/-! ### W3. A product with an a.e.-zero factor is a.e. zero (R39, R40) -/
example {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} (g u : Ω → ℝ) (h : u =ᵐ[μ] 0) :
    g * u =ᵐ[μ] 0 := by
  filter_upwards [h] with ω hω
  simp [hω]

end H060Guide
